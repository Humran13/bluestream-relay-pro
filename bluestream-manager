cli_playlist() {
    local sub="${1:-}" name=""
    shift || true
    case "$sub" in
        list) playlist_list ;;
        create)
            name="${1:-}"
            bs_valid_name "$name" || bs_die "Invalid playlist name"
            playlist_exists "$name" && bs_die "Playlist '$name' already exists"
            mkdir -p "$BLUESTREAM_PLAYLIST_CONF_DIR" 2>/dev/null
            PLAYLIST_NAME="$name"; PLAYLIST_ENABLED="no"; PLAYLIST_FILES=()
            playlist_save_config "$name"
            bs_ok "Playlist '$name' created."
            ;;
        add)
            name="${1:-}"
            shift || true
            [ -n "$name" ] || bs_die "Usage: playlist add <name> <media-file>..."
            playlist_load_config "$name" || bs_die "Playlist '$name' not found"
            local f
            for f in "$@"; do
                bs_valid_media_name "$f" || bs_die "Invalid media name: $f"
                [ -f "$BLUESTREAM_MEDIA_DIR/$f" ] || bs_die "No such managed media: $f"
                case " ${PLAYLIST_FILES[*]} " in
                    *" $f "*) ;;
                    *) PLAYLIST_FILES+=( "$f" ) ;;
                esac
            done
            playlist_save_config "$name"
            bs_ok "Playlist '$name' now has ${#PLAYLIST_FILES[@]} entries."
            ;;
        remove)
            name="${1:-}"
            shift || true
            [ -n "$name" ] || bs_die "Usage: playlist remove <name> <media-file>..."
            playlist_load_config "$name" || bs_die "Playlist '$name' not found"
            local f newlist=()
            for f in "${PLAYLIST_FILES[@]}"; do
                case " $* " in
                    *" $f "*) continue ;;
                esac
                newlist+=( "$f" )
            done
            PLAYLIST_FILES=( "${newlist[@]}" )
            playlist_save_config "$name"
            bs_ok "Playlist '$name' now has ${#PLAYLIST_FILES[@]} entries. Media files were not modified."
            ;;
        reorder)
            name="${1:-}"
            shift || true
            [ -n "$name" ] || bs_die "Usage: playlist reorder <name> <media-file>... (full new order)"
            playlist_load_config "$name" || bs_die "Playlist '$name' not found"
            local newlist=() f
            for f in "$@"; do
                bs_valid_media_name "$f" || bs_die "Invalid media name: $f"
                case " ${PLAYLIST_FILES[*]} " in
                    *" $f "*) ;;
                    *) bs_die "'$f' is not in the playlist" ;;
                esac
                newlist+=( "$f" )
            done
            [ "${#newlist[@]}" -eq "${#PLAYLIST_FILES[@]}" ] || bs_die "Reorder must list every playlist entry exactly once"
            PLAYLIST_FILES=( "${newlist[@]}" )
            playlist_save_config "$name"
            bs_ok "Playlist '$name' reordered."
            ;;
        show) playlist_show "${1:-}" ;;
        check)
            name="${1:-}"
            playlist_load_config "$name" || bs_die "Playlist '$name' not found"
            playlist_check_compat
            ;;
        start|stop|restart|enable|disable|url|player|health|logs|remove)
            cli_playlist_one "$sub" "$@" ;;
        *) bs_die "Unknown playlist action: $sub (see 'help')" ;;
    esac
}

# ---------------------------------------------------------------------------
# Non-interactive CLI: media, server, ssl, firewall
# ---------------------------------------------------------------------------
cli_media() {
    local sub="${1:-}"
    shift || true
    case "$sub" in
        import)
            local src="" name=""
            src="${1:-}"
            shift || true
            while [ "$#" -gt 0 ]; do
                case "$1" in
                    --name) bs_val2 name --name "$@"; shift 2 ;;
                    *) bs_die "Unknown option: $1" ;;
                esac
            done
            [ -n "$src" ] || bs_die "Usage: media import <path-or-url> [--name <name>]"
            media_import "$src" "$name"
            ;;
        list)    media_list ;;
        inspect) media_inspect "${1:-}" ;;
        remove)  media_remove "${1:-}" ;;
        *) bs_die "Unknown media action: $sub (see 'help')" ;;
    esac
}

cli_server() {
    case "${1:-}" in
        test)    nginx_test ;;
        reload)  nginx_reload ;;
        restart) nginx_restart ;;
        *) bs_die "Usage: nginx test|reload|restart" ;;
    esac
}

cli_ssl() {
    case "${1:-}" in
        issue)  ssl_issue ;;
        status) ssl_status ;;
        renew)  ssl_renew ;;
        *) bs_die "Usage: ssl issue|status|renew" ;;
    esac
}

cli_firewall() {
    case "${1:-}" in
        status)    firewall_status ;;
        configure) firewall_configure ;;
        *) bs_die "Usage: firewall status|configure" ;;
    esac
}

# ---------------------------------------------------------------------------
# Top-level dispatch
# ---------------------------------------------------------------------------
cli_main() {
    local cmd="${1:-}"
    case "$cmd" in
        status)      cmd_server_status ;;
        relay)       cli_relay "${@:2}" ;;
        playlist)    cli_playlist "${@:2}" ;;
        media)       cli_media "${@:2}" ;;
        diagnostics) run_diagnostics ;;
        selftest)    run_selftest ;;
        backup)
            case "${2:-}" in
                --with-media) backup_configs yes ;;
                *) backup_configs no ;;
            esac
            ;;
        restore)     backup_restore "${2:-}" ;;
        nginx)       cli_server "${2:-}" ;;
        ssl)         cli_ssl "${2:-}" ;;
        firewall)    cli_firewall "${2:-}" ;;
        info)        cmd_info ;;
        version)     printf '%s\n' "$(bs_version)" ;;
        help|--help|-h) usage ;;
        *) usage; exit 1 ;;
    esac
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
case "${1:-}" in
    version|help|--help|-h|info) ;;
    *)
        if [ "$(id -u)" -ne 0 ]; then
            printf 'BlueStream Relay Pro requires root. Run: sudo bluestream-manager\n' >&2
            exit 2
        fi
        ;;
esac

if [ "$#" -gt 0 ]; then
    cli_main "$@"
else
    menu_main
fi







