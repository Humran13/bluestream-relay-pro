#!/usr/bin/env bash
#
# BlueStream Relay Pro - administration manager.
#
# Primary interface:   sudo bluestream-manager
# Non-interactive CLI: bluestream-manager <command> [arguments]
# Examples:
#   sudo bluestream-manager relay add news --type remote-hls --url https://source.example.com/live/index.m3u8 --start
#   sudo bluestream-manager playlist add channel1 video01.mp4 video02.mp4
#   sudo bluestream-manager selftest
#
# BlueStream Relay Pro 0.1.0 (foundation). See LICENSE for terms.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/lib/common.sh" ]; then
    BS_ROOT="$SCRIPT_DIR"
elif [ -d /usr/local/lib/bluestream ] && [ -f /usr/local/lib/bluestream/lib/common.sh ]; then
    BS_ROOT="/usr/local/lib/bluestream"
else
    printf 'BlueStream Relay Pro: cannot locate library files.\n' >&2
    exit 1
fi

for _bs_lib in common osdetect probe health relay playlist media nginx ssl firewall backup diagnostics selftest; do
    # shellcheck source=lib/common.sh
    # shellcheck source=lib/relay.sh
    # shellcheck source=lib/playlist.sh
    source "$BS_ROOT/lib/$_bs_lib.sh" || { printf 'BlueStream Relay Pro: failed to load library %s\n' "$_bs_lib" >&2; exit 1; }
done
unset _bs_lib

bs_setup

banner() {
    printf '%s==============================================%s\n' "$C_BOLD" "$C_RESET"
    printf '%s   BlueStream Relay Pro v%s%s\n' "$C_CYAN" "$(bs_version)" "$C_RESET"
    printf '%s   self-hosted media relay server%s\n' "$C_CYAN" "$C_RESET"
    printf '%s==============================================%s\n' "$C_BOLD" "$C_RESET"
}

usage() {
    cat <<EOF
BlueStream Relay Pro v$(bs_version) - usage

Interactive:
  sudo bluestream-manager

Non-interactive commands:
  status
  relay list | add | show | start | stop | restart | enable | disable
  relay edit | source | probe | url | player | logs | health | bandwidth | remove
  playlist list | create | add | remove | reorder | show | check
  playlist start | stop | restart | enable | disable | url | player | logs | health
  media import | list | inspect | remove
  diagnostics
  selftest
  backup [--with-media]
  restore [<backup-file>]
  nginx test | reload | restart
  ssl issue | status | renew
  firewall status | configure
  info
  version
  help

Run 'bluestream-manager <command> --help' for command-specific help.
EOF
}

# ---------------------------------------------------------------------------
# Server status / info
# ---------------------------------------------------------------------------
cmd_server_status() {
    bs_step "Server status"
    printf '  Version          : %s\n' "$(bs_version)"
    printf '  Hostname         : %s\n' "$(hostname -f 2>/dev/null || hostname)"
    printf '  OS               : %s %s\n' "$OS_NAME" "$OS_VERSION"
    printf '  Uptime           : %s\n' "$(uptime -p 2>/dev/null || uptime)"
    printf '  Load             : %s\n' "$(cat /proc/loadavg 2>/dev/null | cut -d' ' -f1-3)"
    printf '  Memory           : %s\n' "$(free -h 2>/dev/null | awk '/^Mem:/{print $2" total, "$4" available"}')"
    printf '  Nginx            : %s\n' "$(systemctl is-active nginx 2>/dev/null)"
    printf '  FFmpeg           : %s\n' "$(ffmpeg -version 2>/dev/null | head -n1 | cut -c1-70)"
    printf '  Domain           : %s\n' "${BLUESTREAM_DOMAIN:-(not set)}"
    printf '  SSL              : %s\n' "$BLUESTREAM_SSL_ENABLED"
    printf '  Firewall         : %s\n' "$BLUESTREAM_FIREWALL"
    printf '  Relays           : %s\n' "$(relay_list_names | grep -c . || true)"
    printf '  Playlists        : %s\n' "$(playlist_list_names | grep -c . || true)"
    printf '  Managed media    : %s files\n' "$(media_list_names | grep -c . || true)"
    printf '  Disk /var/lib    : %s\n' "$(bs_disk_free /var/lib 2>/dev/null)"
    printf '  Disk /var/www    : %s\n' "$(bs_disk_free /var/www 2>/dev/null)"
}

cmd_info() {
    banner
    cat <<EOF

BlueStream Relay Pro is a self-hosted 24/7 media relay server for Ubuntu VPS
systems. It accepts supported media sources, pulls them continuously and
exposes a stable public HLS (M3U8) output that works with WordPress, hls.js
web players, VLC, IPTV players and mobile applications.

  Public M3U8 : https://<domain>/hls/relay/<name>/index.m3u8
                https://<domain>/hls/playlist/<name>/index.m3u8
  Player      : https://<domain>/player/?relay=<name>
                https://<domain>/player/?playlist=<name>

Supported source types: local file, local playlist, remote HLS/M3U8, RTMP,
RTMPS, RTSP and direct HTTP/HTTPS media files.

Streaming philosophy: stream copy / remux (-c:v copy -c:a copy) for
compatible H.264 + AAC sources. No automatic transcoding.

H.264 + AAC is the preferred compatibility profile. 4K support depends on
the source codec/bitrate, VPS bandwidth, server resources, viewer count and
player compatibility - it is NOT guaranteed on every VPS.

Installation and usage:
  docs/installation.md, docs/sources.md, docs/playlists.md,
  docs/wordpress.md, docs/troubleshooting.md, docs/security.md
EOF
}

