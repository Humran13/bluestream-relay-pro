# ---------------------------------------------------------------------------
# Uninstall entry point (defined here; delegates to uninstall.sh if present)
# ---------------------------------------------------------------------------
uninstall_entry() {
    local script
    if [ -f "$BS_ROOT/uninstall.sh" ]; then
        script="$BS_ROOT/uninstall.sh"
    elif [ -f /usr/local/lib/bluestream/uninstall.sh ]; then
        script="/usr/local/lib/bluestream/uninstall.sh"
    else
        bs_die "uninstall.sh not found."
    fi
    bs_warn "This will remove BlueStream Relay Pro from this server."
    bs_confirm "Run the uninstaller now?" || return 1
    bash "$script"
    exit 0
}

# ---------------------------------------------------------------------------
# Non-interactive CLI: relays
# ---------------------------------------------------------------------------
cli_relay_add() {
    local name="" type="" url="" loop="no" restart="5" note="" start=0 enable=0
    name="${1:-}"
    shift || true
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --type) bs_val2 type --type "$@"; shift 2 ;;
            --url) bs_val2 url --url "$@"; shift 2 ;;
            --loop) bs_val2 loop --loop "$@"; shift 2 ;;
            --restart-sec) bs_val2 restart --restart-sec "$@"; shift 2 ;;
            --note) bs_val2 note --note "$@"; shift 2 ;;
            --start) start=1; shift ;;
            --enable) enable=1; shift ;;
            *) bs_die "Unknown option: $1" ;;
        esac
    done
    [ -n "$name" ] || bs_die "Usage: relay add <name> --type <type> --url <url> [--loop yes|no] [--restart-sec N] [--start] [--enable]"
    [ -n "$type" ] || bs_die "--type is required (local-file|remote-hls|rtmp|rtmps|rtsp|http-file)"
    [ -n "$url" ] || bs_die "--url is required"
    bs_valid_name "$name" || bs_die "Invalid relay name"
    bs_valid_type "$type" || bs_die "Invalid relay type: $type"
    case "$loop" in yes|no) ;; *) bs_die "Invalid --loop (yes|no)" ;; esac
    bs_valid_restart_sec "$restart" || bs_die "Invalid --restart-sec (1-300)"
    relay_exists "$name" && bs_die "Relay '$name' already exists"

    RELAY_NAME="$name"; RELAY_TYPE="$type"; RELAY_URL="$url"; RELAY_LOOP="$loop"
    RELAY_RESTART_SEC="$restart"; RELAY_ENABLED="no"; RELAY_NOTE="$note"
    RELAY_CREATED="$(bs_now_ts)"
    relay_config_validate || bs_die "Configuration failed validation"
    mkdir -p "$BLUESTREAM_RELAY_CONF_DIR" 2>/dev/null
    relay_save_config "$name"
    bs_ok "Relay '$name' created."
    printf '  M3U8   : %s\n' "$(bs_relay_m3u8_url "$name")"
    printf '  Player : %s\n' "$(bs_relay_player_url "$name")"
    [ "$start" = "1" ] && relay_start "$name"
    [ "$enable" = "1" ] && relay_enable "$name"
    return 0
}

cli_relay_edit() {
    local name="" loop="" restart="" note="" set_loop=0 set_restart=0 set_note=0
    name="${1:-}"
    shift || true
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --loop) bs_val2 loop --loop "$@"; set_loop=1; shift 2 ;;
            --restart-sec) bs_val2 restart --restart-sec "$@"; set_restart=1; shift 2 ;;
            --note) bs_val2 note --note "$@"; set_note=1; shift 2 ;;
            *) bs_die "Unknown option: $1" ;;
        esac
    done
    [ -n "$name" ] || bs_die "Usage: relay edit <name> [--loop yes|no] [--restart-sec N] [--note TEXT]"
    relay_load_config "$name" || bs_die "Relay '$name' not found"
    if [ "$set_loop" = "1" ]; then
        case "$loop" in yes|no) RELAY_LOOP="$loop" ;; *) bs_die "Invalid --loop (yes|no)" ;; esac
    fi
    if [ "$set_restart" = "1" ]; then
        bs_valid_restart_sec "$restart" || bs_die "Invalid --restart-sec (1-300)"
        RELAY_RESTART_SEC="$restart"
    fi
    [ "$set_note" = "1" ] && RELAY_NOTE="$note"
    relay_save_config "$name"
    bs_ok "Relay '$name' updated."
    if bs_unit_active "$(bs_unit relay "$name")"; then
        relay_restart "$name"
    fi
    return 0
}

cli_relay_source() {
    local name="" url="" restart=0
    name="${1:-}"
    shift || true
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --url) bs_val2 url --url "$@"; shift 2 ;;
            --restart) restart=1; shift ;;
            *) bs_die "Unknown option: $1" ;;
        esac
    done
    [ -n "$name" ] && [ -n "$url" ] || bs_die "Usage: relay source <name> --url <url> [--restart]"
    relay_load_config "$name" || bs_die "Relay '$name' not found"
    RELAY_URL="$url"
    relay_config_validate || bs_die "New source failed validation"
    relay_save_config "$name"
    bs_ok "Source updated for relay '$name'."
    if [ "$restart" = "1" ] || bs_unit_active "$(bs_unit relay "$name")"; then
        relay_restart "$name"
    fi
    return 0
}

cli_relay_one() {
    local action="$1" name="${2:-}"
    bs_valid_name "$name" || bs_die "Invalid relay name: '$name'"
    case "$action" in
        show|status) relay_status_detail "$name" ;;
        start)       relay_start "$name" ;;
        stop)        relay_stop "$name" ;;
        restart)     relay_restart "$name" ;;
        enable)      relay_enable "$name" ;;
        disable)     relay_disable "$name" ;;
        probe)       relay_probe_source "$name" ;;
        url)         relay_show_m3u8 "$name" ;;
        player)      relay_show_player "$name" ;;
        health)      relay_health "$name" ;;
        logs)
            local lines="${3:-100}"
            case "$lines" in ''|*[!0-9]*) lines=100 ;; esac
            relay_logs "$name" "$lines"
            ;;
        remove)      relay_remove "$name" ;;
        *) bs_die "Unknown relay action: $action" ;;
    esac
}

cli_relay_bandwidth() {
    local name="${1:-}" viewers="${2:-}" bps mbps total
    relay_load_config "$name" || bs_die "Relay '$name' not found"
    bps="$(probe_pick_bitrate)"
    if [ "$bps" = "0" ] || [ -z "$bps" ]; then
        bs_warn "Source bitrate could not be determined from probe data."
        bs_warn "Run 'bluestream-manager relay probe $name' or use the interactive estimator."
        return 1
    fi
    mbps="$(bandwidth_mbps_from_bps "$bps")"
    if [ -z "$viewers" ]; then
        bs_prompt viewers "Expected simultaneous viewers" "" || return 1
    fi
    case "$viewers" in ''|*[!0-9]*) bs_die "Invalid viewer count" ;; esac
    total="$(estimate_bandwidth "$mbps" "$viewers")"
    printf 'Source bitrate %s Mbps x %s viewers = %s Mbps outbound (approx)\n' "$mbps" "$viewers" "$total"
    bandwidth_show_explanation
    return 0
}

cli_relay() {
    local sub="${1:-}"
    shift || true
    case "$sub" in
        list)      relay_list ;;
        add)       cli_relay_add "$@" ;;
        edit)      cli_relay_edit "$@" ;;
        source)    cli_relay_source "$@" ;;
        bandwidth) cli_relay_bandwidth "$@" ;;
        show|status|start|stop|restart|enable|disable|probe|url|player|health|logs|remove)
            cli_relay_one "$sub" "$@" ;;
        *) bs_die "Unknown relay action: $sub (see 'help')" ;;
    esac
}

