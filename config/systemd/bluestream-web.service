# BlueStream Relay Pro - web console systemd unit template (GUI-1A.3A).
#
# Installed by GUI-1A.3B as:  /etc/systemd/system/bluestream-web.service
#
# The web console runs unprivileged as bluestream-web, listens ONLY on
# 127.0.0.1:8080, and reaches the root-owned BlueStream engine through the
# narrowly scoped sudoers entry (config/sudoers/bluestream-web). nginx is the
# only front-end; Gunicorn is never exposed publicly.
#
# PATH/VERIFICATION NOTES (GUI-1A.3B must verify on the real Ubuntu host):
#   - /usr/bin/gunicorn is the Debian/Ubuntu python3-gunicorn path; if
#     installed into a venv, replace with the absolute venv gunicorn path.
#   - WorkingDirectory=/usr/local/lib/bluestream matches where the installer
#     places the webapp package (so `webapp.wsgi:application` imports).
#   - /var/lib/bluestream/web must be created by the installer and readable by
#     bluestream-web (admin.json, secret_key). ProtectSystem=strict keeps the
#     rest read-only; ReadWritePaths permits only that state directory.

[Unit]
Description=BlueStream Relay Pro - web console (Gunicorn)
Documentation=file:/usr/local/lib/bluestream/docs/installation.md
Wants=network-online.target
After=network-online.target nginx.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=bluestream-web
Group=bluestream-web
WorkingDirectory=/usr/local/lib/bluestream
# PYTHONNOUSERSITE: never import from ~/.local user site-packages (import
# hardening for an unprivileged web user). PYTHONUNBUFFERED keeps logs flowing.
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
ExecStart=/usr/bin/gunicorn --workers 1 --bind 127.0.0.1:8080 webapp.wsgi:application
Restart=on-failure
RestartSec=5

# --- Hardening ----------------------------------------------------------------
# NOTE: NoNewPrivileges=true is deliberately NOT set. The service must run
# `sudo -n /usr/local/lib/bluestream/web-ctl`, which requires gaining root;
# NoNewPrivileges would break that. CapabilityBoundingSet / RestrictSUIDSGID
# are also omitted for the same reason and MUST be verified on Ubuntu before
# adding. All directives below are compatible with the sudo path.
ProtectSystem=strict
# ProtectSystem=strict keeps the service namespace read-only except for the
# narrowly scoped paths below. bluestream-web itself never gains write access;
# these exceptions exist so that the ROOT web-ctl child (reached through the
# fixed sudoers grant) can perform the engine's existing preparation writes
# during browser Start/Restart/import while it runs inside this same mount
# namespace (file permissions are still enforced on disk - the web user stays
# unable to write any of these paths):
#   /run/sudo               - sudo timestamp directory (NOPASSWD)
#   /etc/systemd/system     - relay/playlist dropin override.conf writes
#                             (relay_sync_dropin) and GUI-8A generated
#                             bluestream-schedule-<name>.timer units
#                             (schedule_set / schedule_clear); root:root 0644,
#                             so only the sudo-root web-ctl child can write them
#   /etc/bluestream/relays  - relay config create/save (relay_create /
#                             relay_save_config); on disk root:root 0600, so
#                             only the sudo-root web-ctl child can write
#                             inside the namespace
#   /etc/bluestream/playlists - GUI-1D.1 playlist config create/save
#                             (playlist_create / playlist_save_config) and the
#                             GUI-8A <name>.schedule sidecar (schedule_set);
#                             same root:root 0600 model as the relays
#                             directory, so only the sudo-root web-ctl child
#                             can write inside the namespace
#   /etc/bluestream/destinations - GUI-4 Phase 1A destination config
#                             create/save (destination_create and the
#                             enable/disable toggle); same root:root 0600
#                             model, so only the sudo-root web-ctl child can
#                             write stream keys inside this namespace
#   /var/www/bluestream/hls - HLS output directories created by
#                             bs_ensure_hls_dir for relays and playlists
#   /var/lib/bluestream/run - playlist concat file (playlist_write_concat_file)
#                             and the root-only media-import quarantine
#                             (BLUESTREAM_MEDIA_QUARANTINE_DIR: root:root 0700,
#                             used by the root media_import_staged bridge)
#   /var/lib/bluestream/web/upload - GUI-1C.1 web upload staging area. This is
#                             the ONLY path the unprivileged web process can
#                             actually write (root:bluestream-web 0770); the
#                             root bridge imports from here into managed media.
#   /var/lib/bluestream/media - managed media imports (media_import_staged);
#                             on disk root:bluestream-relay 0750, so only the
#                             root bridge can write inside the namespace.
# Ownership/modes of these paths are unchanged; the web state dir below stays
# READ-ONLY for bluestream-web (root:bluestream-web 0640/0750; the installer
# pre-creates admin.json/secret_key/web.conf).
ReadWritePaths=/run/sudo /etc/systemd/system /etc/bluestream/relays /etc/bluestream/playlists /etc/bluestream/destinations /var/www/bluestream/hls /var/lib/bluestream/run /var/lib/bluestream/web/upload /var/lib/bluestream/media
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true

SyslogIdentifier=bluestream-web
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
