# BlueStream Relay Pro - ISOLATED nginx instance unit.
#
# Installed ONLY when lib/envdetect.sh classified this host as already
# running a control panel, Apache, or Caddy (BLUESTREAM_NGINX_STRATEGY=
# isolated in server.conf). Entirely independent of the system nginx.service
# and nginx package configuration: its own config root
# (/etc/bluestream/nginx), its own pidfile, its own log directory. Starting,
# stopping, or restarting this unit never affects the system nginx or any
# other web server/panel on this host, and vice versa.
#
# Mirrors the standard Debian/Ubuntu nginx.service Type=forking pattern.

[Unit]
Description=BlueStream Relay Pro - isolated nginx instance (streaming engine + web console, independent of the system nginx/web server/control panel)
Documentation=file:/usr/local/lib/bluestream/docs/installation.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=forking
PIDFile=/run/bluestream-nginx.pid
ExecStartPre=/usr/sbin/nginx -t -c /etc/bluestream/nginx/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/bluestream/nginx/nginx.conf
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -QUIT $MAINPID
Restart=on-failure
RestartSec=5

# --- Hardening -----------------------------------------------------------
# A conservative subset only: the master process runs as root (same as the
# stock system nginx.service - needed to bind ports and manage the worker
# processes it forks and drops to the configured `user` directive), and it
# legitimately needs broad read access (its own config, mime.types, the
# bundled web player, HLS output it writes as www-data, future SSL certs).
# ProtectSystem=strict + an exhaustive ReadWritePaths list was deliberately
# NOT attempted here - getting that wrong would silently break the
# streaming engine, which is worse than the modest gap below. These
# directives are all safe regardless (nginx needs none of what they
# restrict) and are verified not to interfere with startup.
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

SyslogIdentifier=bluestream-nginx
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
