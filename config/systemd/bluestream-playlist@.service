# BlueStream Relay Pro - playlist unit template.
# Instantiated as:  bluestream-playlist@<playlist-name>.service
# Installed to:     /etc/systemd/system/bluestream-playlist@.service
#
# The wrapper reads the root-only playlist config, normalizes every entry into
# the managed playlist cache, writes the concat file (listing only the
# prepared baseline artifacts), prepares the HLS output directory, then
# permanently drops privileges (setpriv) before exec'ing FFmpeg. FFmpeg never
# runs as root.

[Unit]
Description=BlueStream Relay Pro - Playlist %i
Documentation=file:/usr/local/lib/bluestream/docs/playlists.md
Wants=network-online.target
After=network-online.target nginx.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/lib/bluestream/run-playlist.sh %i
Restart=on-failure
RestartSec=5

# --- Hardening (directives available since systemd 231; OK on Ubuntu 20.04+) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true

# Narrow writable paths. FFmpeg publishes over the private local RTMP socket
# only; nginx-rtmp (www-data) owns the HLS output tree. The run directory is
# needed for the generated concat file and preparation marker; the playlist
# cache is where the root bootstrap publishes normalized baseline artifacts
# (read by the dropped-privilege FFmpeg concat process).
ReadWritePaths=/var/lib/bluestream/run /var/lib/bluestream/playlist-cache

SyslogIdentifier=bluestream-playlist-%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
