# BlueStream Relay Pro - playlist unit template.
# Instantiated as:  bluestream-playlist@<playlist-name>.service
# Installed to:     /etc/systemd/system/bluestream-playlist@.service
#
# The wrapper reads the root-only playlist config, normalizes every entry
# into the managed playlist cache, writes the concat file (listing only the
# prepared baseline artifacts), then re-execs itself as the unprivileged
# bluestream-relay user (setpriv) to run the actual FFmpeg supervision loop
# (lib/supervise.sh, shared with run-relay.sh - never duplicated). FFmpeg
# never runs as root. Playlists are always the continuous/24-7 case (no
# finite-playlist concept exists): any unexpected FFmpeg termination,
# including a clean exit 0, is reconnected with bounded exponential
# backoff rather than left stopped - the same root-cause fix as relays.
# Restart=on-failure/StartLimitBurst below are an OUTER safety net only,
# for when the internal supervisor itself gives up.

[Unit]
Description=BlueStream Relay Pro - Playlist %i
Documentation=file:/usr/local/lib/bluestream/docs/playlists.md
Wants=network-online.target
After=network-online.target nginx.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/lib/bluestream/run-playlist.sh %i
Restart=on-failure
RestartSec=5

# --- Hardening (directives available since systemd 231; OK on Ubuntu 20.04+) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true

# Narrow writable paths. FFmpeg publishes over the private local RTMP socket
# only; nginx-rtmp (www-data) owns the HLS output tree. The run directory is
# needed for the generated concat file and preparation marker; the playlist
# cache is where the root bootstrap publishes normalized baseline artifacts
# (read by the dropped-privilege FFmpeg concat process). /etc/systemd/system
# is writable ONLY for the root bootstrap's Phase 1C publisher sync (see the
# matching comment in bluestream-relay@.service).
ReadWritePaths=/var/lib/bluestream/run /var/lib/bluestream/playlist-cache /etc/systemd/system

SyslogIdentifier=bluestream-playlist-%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
