# BlueStream Relay Pro - relay unit template.
# Instantiated as:  bluestream-relay@<relay-name>.service
# Installed to:     /etc/systemd/system/bluestream-relay@.service
#
# The wrapper reads the root-only relay config, prepares the HLS output
# directory, then permanently drops privileges (setpriv) before exec'ing
# FFmpeg. FFmpeg never runs as root.

[Unit]
Description=BlueStream Relay Pro - Relay %i
Documentation=file:/usr/local/lib/bluestream/docs/installation.md
Wants=network-online.target
After=network-online.target nginx.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/lib/bluestream/run-relay.sh %i
Restart=on-failure
RestartSec=5

# --- Hardening (directives available since systemd 231; OK on Ubuntu 20.04+) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true

# Narrow writable paths. FFmpeg publishes over the private local RTMP socket
# only; nginx-rtmp (www-data) owns the HLS output tree, so FFmpeg requires no
# writable filesystem path. The run directory is writable ONLY for the root
# bootstrap, which clears/writes the resolver start-failure diagnostic
# (<name>.resolve-fail, 0600 root) before dropping privileges.
ReadWritePaths=/var/lib/bluestream/run

SyslogIdentifier=bluestream-relay-%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
