# BlueStream Relay Pro - relay unit template.
# Instantiated as:  bluestream-relay@<relay-name>.service
# Installed to:     /etc/systemd/system/bluestream-relay@.service
#
# The wrapper reads the root-only relay config as root, then permanently
# drops privileges (setpriv, by re-exec'ing itself) before running FFmpeg.
# FFmpeg never runs as root. The unprivileged process is a SUPERVISION LOOP
# (lib/supervise.sh), not a single `exec ffmpeg`: it runs FFmpeg as its own
# child, in a retry loop, so it can tell a deliberate stop apart from an
# unexpected live-source EOF (FFmpeg exits 0 on both - systemd's
# ActiveState/Result cannot distinguish them, which is why a live relay
# that hit a transient source hiccup could previously go silently
# unrestarted). Restart=on-failure/StartLimitBurst below are an OUTER
# safety net only, for when the internal loop itself gives up.
[Unit]
Description=BlueStream Relay Pro - Relay %i
Documentation=file:/usr/local/lib/bluestream/docs/installation.md
Wants=network-online.target
After=network-online.target nginx.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/local/lib/bluestream/run-relay.sh %i
Restart=on-failure
RestartSec=5

# --- Hardening (directives available since systemd 231; OK on Ubuntu 20.04+) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true

# Narrow writable paths. FFmpeg publishes over the private local RTMP socket
# only; nginx-rtmp (www-data) owns the HLS output tree, so FFmpeg requires no
# writable filesystem path. The run directory is writable ONLY for the root
# bootstrap, which clears/writes the resolver start-failure diagnostic
# (<name>.resolve-fail, 0600 root) before dropping privileges. /etc/systemd/
# system is writable ONLY for the root bootstrap's Phase 1C publisher sync
# (publisher_sync_target writes/removes bluestream-publisher@<instance>.
# service.d/override.conf drop-ins) - it runs before the privilege drop, on
# every start of this unit, regardless of what triggered it.
ReadWritePaths=/var/lib/bluestream/run /etc/systemd/system

SyslogIdentifier=bluestream-relay-%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
