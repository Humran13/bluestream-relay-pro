# BlueStream Relay Pro - private local RTMP ingest -> HLS (nginx MAIN context).
#
# Loaded at nginx MAIN context via /etc/nginx/modules-enabled/60-bluestream-rtmp.conf
# AFTER ngx_rtmp_module has been loaded (50-mod-rtmp.conf sorts first).
#
# Loopback only: this RTMP ingest must never be reachable from the public
# network. Public playback uses the existing HTTP HLS URLs, not RTMP.

rtmp {
    server {
        listen __RTMP_BIND__:__RTMP_PORT__;

        application bluestream-relay {
            live on;
            allow publish 127.0.0.1;
            deny publish all;
            # Phase 1C: outbound publisher processes PLAY (subscribe to) this
            # exact stream as loopback RTMP clients to fan it out to each
            # attached destination. Still never reachable for play from
            # anywhere but this host - only the loopback allowance is added.
            allow play 127.0.0.1;
            deny play all;

            hls on;
            hls_path __HLS_ROOT__/relay;
            hls_nested on;
            hls_fragment 5s;
            hls_playlist_length 30s;
            hls_continuous on;
            hls_cleanup on;
        }

        application bluestream-playlist {
            live on;
            allow publish 127.0.0.1;
            deny publish all;
            # Phase 1C: see the matching comment in bluestream-relay above.
            allow play 127.0.0.1;
            deny play all;

            hls on;
            hls_path __HLS_ROOT__/playlist;
            hls_nested on;
            hls_fragment 5s;
            hls_playlist_length 30s;
            hls_continuous on;
            hls_cleanup on;
        }
    }
}
