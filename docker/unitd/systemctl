#!/usr/bin/env python3
"""systemctl shim for the BlueStream container: talks to bsunitd. Implements only the verbs BlueStream uses."""
import json
import os
import socket
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import bsunitd as B  # noqa: E402

OPTIONAL = os.environ.get("BS_UNITD_OPTIONAL") == "1"      # image build: no daemon yet, start/stop are no-ops


def ask(op, *args):
    try:
        s = socket.socket(socket.AF_UNIX)
        s.settimeout(40)
        s.connect(B.SOCK)
        s.sendall((json.dumps({"op": op, "args": list(args)}) + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
        s.close()
        return json.loads(data.decode())
    except (OSError, ValueError):
        return None


def marker(unit):
    return os.path.join(B.STATE_DIR, "enabled", unit)


def main(argv):
    opts, pos = set(), []
    props = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-p", "--property"):
            props += argv[i + 1].split(",")
            i += 2
            continue
        if a.startswith("--property="):
            props += a.split("=", 1)[1].split(",")
        elif a.startswith("-") and a not in ("-"):
            opts.add(a)
        else:
            pos.append(a)
        i += 1
    if not pos:
        sys.stderr.write("systemctl: no command given\n")
        return 1
    verb, units = pos[0], pos[1:]
    rc = 0

    if verb == "daemon-reload":
        return 0
    if verb in ("enable", "reenable", "disable"):
        for u in units:
            try:
                name = B.unit_name(u)
            except ValueError:
                sys.stderr.write("Invalid unit name %s\n" % u)
                rc = 1
                continue
            if verb != "disable" and B.load_unit(name) is None:
                sys.stderr.write("Failed to %s unit: Unit file %s does not exist.\n" % (verb, name))
                rc = 1
                continue
            os.makedirs(os.path.dirname(marker(name)), exist_ok=True)
            if verb == "disable":
                try:
                    os.unlink(marker(name))
                except FileNotFoundError:
                    pass
            else:
                open(marker(name), "w").close()
        return rc
    if verb == "is-enabled":
        for u in units:
            try:
                name = B.unit_name(u)
            except ValueError:
                print("not-found")
                rc = 1
                continue
            if B.load_unit(name) is None:
                sys.stderr.write("Failed to get unit file state for %s: No such file or directory\n" % name)
                rc = 1
            elif os.path.exists(marker(name)):
                print("enabled")
            else:
                print("disabled")
                rc = 1
        return rc

    if verb in ("start", "stop", "restart", "reload", "reset-failed", "try-restart"):
        for u in units:
            try:
                name = B.unit_name(u)
            except ValueError:
                sys.stderr.write("Invalid unit name %s\n" % u)
                rc = 1
                continue
            reply = ask("restart" if verb == "try-restart" else verb, name)
            if reply is None:
                if not OPTIONAL:
                    sys.stderr.write("Failed to %s %s: the BlueStream unit manager (bsunitd) is not running.\n" % (verb, name))
                    rc = 1
                continue
            if not reply.get("ok"):
                sys.stderr.write("Failed to %s %s: %s\n" % (verb, name, reply.get("msg", "")))
                rc = 1
        return rc

    if verb in ("is-active", "is-failed", "show", "status"):
        for u in units:
            try:
                name = B.unit_name(u)
            except ValueError:
                print("inactive")
                rc = 3
                continue
            reply = ask("show", name)
            snap = reply["data"] if reply and reply.get("ok") else {"ActiveState": "inactive", "SubState": "dead", "Result": "success", "NRestarts": 0,
                                                                     "MainPID": 0, "ExecMainStatus": 0, "ActiveEnterTimestamp": "", "loaded": B.load_unit(name) is not None}
            if verb == "is-active":
                print(snap["ActiveState"])
                if snap["ActiveState"] != "active":
                    rc = 3
            elif verb == "is-failed":
                print(snap["ActiveState"])
                if snap["ActiveState"] != "failed":
                    rc = 1
            elif verb == "show":
                keys = props or ["ActiveState", "SubState", "Result", "NRestarts", "MainPID", "ExecMainStatus", "ActiveEnterTimestamp"]
                for k in keys:
                    v = snap.get(k, "")
                    print(str(v) if "--value" in opts else "%s=%s" % (k, v))
            else:
                print("* %s\n     Active: %s (%s)" % (name, snap["ActiveState"], snap["SubState"]))
                if snap["ActiveState"] != "active":
                    rc = 3
        return rc

    if verb == "list-units":
        reply = ask("list", *units)
        rows = reply["data"] if reply and reply.get("ok") else []
        show_all = "--all" in opts or "-a" in opts
        for r in rows:
            if not show_all and r["active"] != "active":
                continue
            print("%s loaded %s %s %s" % (r["unit"], r["active"], r["sub"], r["description"]))
        return 0
    sys.stderr.write("systemctl shim: unsupported command '%s'\n" % verb)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
