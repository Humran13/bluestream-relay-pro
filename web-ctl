#!/usr/bin/env bash
#
# BlueStream Relay Pro - read-only web control bridge (GUI-1A.1).
#
# Machine-readable JSON front-end over the existing BlueStream Bash libraries,
# designed to be called by the Flask console application.
#
# Read-only operations:
#
#   web-ctl version
#   web-ctl snapshot
#   web-ctl relay_list
#   web-ctl playlist_list
#   web-ctl media_list
#
# Controlled lifecycle operations (GUI-1B.1).  Each accepts exactly ONE target
# name, validated with the engine's own bs_valid_name rule before any engine
# function runs, and must reference an existing relay/playlist.  The operation
# itself is fixed by the hard-coded dispatch allowlist:
#
#   web-ctl relay_start <name>
#   web-ctl relay_stop <name>
#   web-ctl relay_restart <name>
#   web-ctl playlist_start <name>
#   web-ctl playlist_stop <name>
#   web-ctl playlist_restart <name>
#
# GUI-1C.1 creation/import operations (exact argc, strict validation, data
# never interpolated into shell code):
#
#   web-ctl relay_create_url <name> <url>
#   web-ctl relay_create_media <name> <mediafile>
#   web-ctl media_import_staged <stagingid>
#
# GUI-1D.1 playlist creation (fixed argv only; the operation is fixed, the
# name and every media item are independently revalidated, nothing is ever
# interpolated into shell code):
#
#   web-ctl playlist_create <name> <mediafile...>
#
# GUI-3A playlist cache management (fixed operations, NO browser-supplied path
# or filename; operate ONLY on the fixed managed playlist cache root):
#
#   web-ctl playlist_cache_status          (read-only cache totals/protected)
#   web-ctl playlist_cache_clear_unused    (delete only reclaimable artifacts)
#
# GUI-4 destination management foundation (Phase 1A). Read-only list never
# returns the stored stream key - only a has_stream_key flag.  Mutations take
# a fixed, validated destination ID plus (for create) bounded non-secret data
# values; the stream key is delivered to destination_create through STDIN -
# never argv, environment, files, or command substitution - and is NEVER
# echoed or returned.  No outgoing RTMP worker or service is created:
#
#   web-ctl destination_list
#   web-ctl destination_create <id> <display> <platform> <url> <yes|no>
#       (the stream key is read from STDIN - never an argv element)
#   web-ctl destination_enable  <id>
#   web-ctl destination_disable <id>
#   web-ctl destination_delete  <id>
#       (refused while the destination is attached to a stream or playlist)
#
# GUI-4 Phase 1B destination ATTACHMENTS.  A stream/playlist config carries at
# most one bounded line "DESTINATIONS=id1,id2,..." listing destination IDs
# ONLY (never a stream key/secret/publish URL).  Attaching or detaching only
# rewrites that config line - it NEVER starts, stops or restarts a running
# stream/playlist, and never begins an outgoing RTMP push (that is Phase 1C):
#
#   web-ctl relay_destinations_get     <name>
#   web-ctl relay_destinations_set     <name> <id,id,...|"">
#   web-ctl playlist_destinations_get  <name>
#   web-ctl playlist_destinations_set  <name> <id,id,...|"">
#
# GUI-5A SAFE DELETE.  Each deletes EXACTLY the named target's own artifacts
# and ONLY when it is definitively stopped (relay/playlist) or unreferenced
# (media).  Never a generic path, never a recursive directory removal, never a
# symlink follow.  Media originals used by a stream/playlist and destination
# definitions are never touched:
#
#   web-ctl relay_delete    <name>   (only when the unit is definitively stopped)
#   web-ctl playlist_delete <name>   (only when the unit is definitively stopped)
#   web-ctl media_delete    <file>   (only when no stream/playlist references it)
#
# GUI-6A EDIT SOURCE URL.  Changes ONLY the source URL (and the derived TYPE)
# of a URL-backed stream, and ONLY while it is definitively stopped.  Media-
# backed streams are rejected.  Name, attachments, note, loop, restart delay
# and the public M3U8 / Web Player URLs are preserved.  The stream is NOT
# started:
#
#   web-ctl relay_set_source <name> <url>
#
# GUI-8A ONE-TIME PLAYLIST START SCHEDULE.  Performs the equivalent of pressing
# "Start" on a playlist at ONE validated future instant (UTC epoch, browser-
# supplied ISO string is display-only and independently re-validated).  Never
# schedules a Stop, never recurs, never schedules an arbitrary command - a
# root-generated systemd timer targets a fixed oneshot service that runs the
# authoritative playlist_start:
#
#   web-ctl playlist_schedule_get   <name>
#   web-ctl playlist_schedule_set   <name> <epoch-utc> <iso-display>
#   web-ctl playlist_schedule_clear <name>
#
# The lifecycle actions, the create/import operations above, the two cache
# operations, the four attachment setters and the three safe-delete operations
# are the ONLY write operations at any layer.  No generic configuration
# editing, arbitrary-path deletion, or user-management operations exist.
#
# Output contract:
#   success -> {"ok": true,  "data": ...}                    on stdout, exit 0
#   failure -> {"ok": false, "error": ..., "code": ...}      on stdout, exit nonzero
#
# JSON is produced by webapp/json_helper.py (Python stdlib json) from a
# NUL-delimited stream.  No value is ever interpolated into a JSON literal by
# the shell, so arbitrary strings (quotes, newlines, tabs, Unicode, ...) stay
# valid JSON.  Debug output, if any, goes to stderr only.
#
# Security: hard-coded operation allowlist, no eval, no dynamic dispatch, no
# arbitrary command execution, no environment-based code execution, no
# credential leakage (source URLs are never emitted), fail closed.
#
# BlueStream Relay Pro 0.1.0 (foundation). See LICENSE for terms.
set -u

# Environment hardening for privileged use (defense-in-depth on top of the
# sudoers env_reset configured in a later phase): never let caller-controlled
# variables make this script or the Python helper load attacker code.
#   PYTHONPATH/PYTHONHOME - would let an attacker shadow stdlib modules
#   BASH_ENV/ENV          - would make child shells source attacker files
#   CDPATH                - would make `cd` resolve through attacker dirs
#   GLOBIGNORE            - would alter glob expansion semantics
unset BASH_ENV ENV PYTHONPATH PYTHONHOME CDPATH GLOBIGNORE 2>/dev/null || true

# Predictable command search: standard system directories first.  Existing
# environment directories remain appended so non-standard installs (and local
# development trees) can still resolve python3/python.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"

# ---------------------------------------------------------------------------
# Locate install root and the Python JSON helper.
# ---------------------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/lib/common.sh" ]; then
    BS_ROOT="$SCRIPT_DIR"
elif [ -d /usr/local/lib/bluestream ] && [ -f /usr/local/lib/bluestream/lib/common.sh ]; then
    BS_ROOT="/usr/local/lib/bluestream"
else
    printf '%s\n' '{"ok": false, "error": "cannot locate BlueStream libraries", "code": "NO_LIBRARIES"}'
    exit 1
fi

BS_JSON_HELPER="$BS_ROOT/webapp/json_helper.py"

# Prefer the absolute trusted interpreter on installed/privileged systems;
# fall back to PATH lookup so local development trees (e.g. Git Bash on
# Windows) still resolve python3/python.
if [ -x /usr/bin/python3 ]; then
    BS_PYTHON="/usr/bin/python3"
else
    BS_PYTHON="$(command -v python3 2>/dev/null || command -v python 2>/dev/null || true)"
fi
if [ -z "$BS_PYTHON" ]; then
    printf '%s\n' '{"ok": false, "error": "python3 is required for JSON output", "code": "NO_PYTHON"}'
    exit 1
fi

# ---------------------------------------------------------------------------
# Load the existing engine libraries (read-only helpers only).  All BlueStream
# business logic (version, config parsing, discovery, service state, health)
# stays in these libraries; Python is used only for JSON serialization.
# ---------------------------------------------------------------------------
for _bs_lib in common health probe relay playlist media destinations schedule; do
    # shellcheck source=lib/common.sh
    . "$BS_ROOT/lib/$_bs_lib.sh" || {
        printf '%s\n' '{"ok": false, "error": "failed to load a BlueStream library", "code": "LIB_LOAD_FAILED"}'
        exit 1
    }
done
unset _bs_lib
bs_setup

# ---------------------------------------------------------------------------
# JSON emission helpers (all serialization goes through the Python helper).
# ---------------------------------------------------------------------------

# wc_json <mode>: run the helper with stdin carrying NUL-delimited records.
wc_json() {
    local mode="$1"
    if [ ! -f "$BS_JSON_HELPER" ]; then
        printf '%s\n' '{"ok": false, "error": "JSON helper not found", "code": "NO_JSON_HELPER"}'
        return 1
    fi
    "$BS_PYTHON" "$BS_JSON_HELPER" "$mode"
    return $?
}

# wc_fail <message> <code>: emit a failure envelope to stdout and exit nonzero.
wc_fail() {
    local msg="$1" code="$2"
    if [ ! -f "$BS_JSON_HELPER" ]; then
        printf '%s\n' '{"ok": false, "error": "JSON helper not found", "code": "NO_JSON_HELPER"}'
    else
        printf 'error\0%s\0code\0%s\0' "$msg" "$code" | "$BS_PYTHON" "$BS_JSON_HELPER" error
    fi
    exit 1
}

# ---------------------------------------------------------------------------
# Read-only operations
# ---------------------------------------------------------------------------

wc_op_version() {
    local ver
    ver="$(bs_version)"
    printf 'version\0%s\0' "$ver" | wc_json object
}

wc_op_snapshot() {
    local ver hostname_str uptime_str domain https_conf nginx_active
    local ffmpeg_ok ffprobe_ok ytdlp_ok relay_count playlist_count
    ver="$(bs_version)"
    hostname_str="$(hostname -f 2>/dev/null || hostname 2>/dev/null || printf 'unknown')"
    uptime_str="$(uptime -p 2>/dev/null || uptime 2>/dev/null || printf 'unknown')"
    domain="${BLUESTREAM_DOMAIN:-}"
    if [ "${BLUESTREAM_SSL_ENABLED:-no}" = "yes" ]; then https_conf="yes"; else https_conf="no"; fi
    nginx_active="no"
    if [ "$(systemctl is-active nginx 2>/dev/null)" = "active" ]; then nginx_active="yes"; fi
    ffmpeg_ok="no";  command -v ffmpeg  >/dev/null 2>&1 && ffmpeg_ok="yes"
    ffprobe_ok="no"; command -v ffprobe >/dev/null 2>&1 && ffprobe_ok="yes"
    # GUI-7A: yt-dlp is required only for TYPE=youtube (public YouTube Live)
    # sources; every other source type works without it.
    ytdlp_ok="no";   command -v yt-dlp  >/dev/null 2>&1 && ytdlp_ok="yes"
    relay_count="$(relay_list_names 2>/dev/null | grep -c . || true)"
    playlist_count="$(playlist_list_names 2>/dev/null | grep -c . || true)"
    [ -n "$relay_count" ] || relay_count="0"
    [ -n "$playlist_count" ] || playlist_count="0"
    {
        printf 'version\0%s\0'           "$ver"
        printf 'hostname\0%s\0'          "$hostname_str"
        printf 'uptime\0%s\0'            "$uptime_str"
        printf 'domain\0%s\0'            "$domain"
        printf 'https_configured\0%s\0'  "$https_conf"
        printf 'nginx_active\0%s\0'      "$nginx_active"
        printf 'ffmpeg_available\0%s\0'  "$ffmpeg_ok"
        printf 'ffprobe_available\0%s\0' "$ffprobe_ok"
        printf 'ytdlp_available\0%s\0'   "$ytdlp_ok"
        printf 'relay_count\0%s\0'       "$relay_count"
        printf 'playlist_count\0%s\0'    "$playlist_count"
    } | wc_json object
}

wc_op_relay_list() {
    local name unit active enabled type health source destcount
    for name in $(relay_list_names 2>/dev/null); do
        # Names come from validated relay config discovery ([a-z0-9_-]{1,48});
        # the for-loop word split is therefore safe.
        unit="$(bs_unit relay "$name")"
        active="no"
        if [ "$(systemctl is-active "$unit" 2>/dev/null)" = "active" ]; then active="yes"; fi
        enabled="no"
        if [ "$(systemctl is-enabled "$unit" 2>/dev/null)" = "enabled" ]; then enabled="yes"; fi
        type="unknown"
        health="UNKNOWN"
        source=""
        destcount="0"
        if relay_load_config "$name" 2>/dev/null; then
            type="$RELAY_TYPE"
            # Display-only representation: credentials/query tokens are redacted.
            source="$(bs_redact_url "$RELAY_URL")"
            # Phase 1B: number of attached destinations (IDs only; the stream
            # key is never loaded or emitted here).
            destcount="$(bs_dest_attach_count "$RELAY_DESTINATIONS")"
            if health_state relay "$name" 2>/dev/null; then
                health="$HEALTH_STATE"
            fi
        fi
        {
            printf '\0'
            printf 'name\0%s\0'              "$name"
            printf 'type\0%s\0'              "$type"
            printf 'source\0%s\0'            "$source"
            printf 'active\0%s\0'            "$active"
            printf 'enabled\0%s\0'           "$enabled"
            printf 'health\0%s\0'            "$health"
            printf 'destination_count\0%s\0' "$destcount"
        }
    done | wc_json array
}

wc_op_playlist_list() {
    local name unit active enabled items health destcount scheduled sched_at sched_iso sched_state
    for name in $(playlist_list_names 2>/dev/null); do
        # Names come from validated playlist config discovery ([a-z0-9_-]{1,48}).
        unit="$(bs_unit playlist "$name")"
        active="no"
        if [ "$(systemctl is-active "$unit" 2>/dev/null)" = "active" ]; then active="yes"; fi
        enabled="no"
        if [ "$(systemctl is-enabled "$unit" 2>/dev/null)" = "enabled" ]; then enabled="yes"; fi
        # GUI-1D.1: item count and health re-use the engine's own config loader
        # and health classifier (never a second implementation in the web layer).
        items="0"
        destcount="0"
        if playlist_load_config "$name" 2>/dev/null; then
            items="${#PLAYLIST_FILES[@]}"
            destcount="$(bs_dest_attach_count "$PLAYLIST_DESTINATIONS")"
        fi
        health="UNKNOWN"
        if health_state playlist "$name" 2>/dev/null; then health="$HEALTH_STATE"; fi
        # GUI-8A: one-time start schedule (if any). Never emits anything but the
        # absolute instant, its display string, and whether it is still pending
        # or has already been missed (the instant has passed).
        scheduled="no"; sched_at=""; sched_iso=""; sched_state=""
        if schedule_load "$name" 2>/dev/null; then
            scheduled="yes"; sched_at="$SCHEDULE_START_AT"; sched_iso="$SCHEDULE_START_AT_ISO"
            sched_state="$(schedule_state "$SCHEDULE_START_AT")"
        fi
        {
            printf '\0'
            printf 'name\0%s\0'               "$name"
            printf 'active\0%s\0'             "$active"
            printf 'enabled\0%s\0'            "$enabled"
            printf 'items\0%s\0'              "$items"
            printf 'health\0%s\0'             "$health"
            printf 'destination_count\0%s\0'  "$destcount"
            printf 'scheduled\0%s\0'          "$scheduled"
            printf 'scheduled_at\0%s\0'       "$sched_at"
            printf 'scheduled_at_iso\0%s\0'   "$sched_iso"
            printf 'schedule_state\0%s\0'     "$sched_state"
        }
    done | wc_json array
}

# ---------------------------------------------------------------------------
# GUI-1C.1: media library and relay creation (fixed argc + strict validation).
# ---------------------------------------------------------------------------

wc_op_media_list() {
    local name size ext
    for name in $(media_list_names 2>/dev/null); do
        size="$(stat -c '%s' "$BLUESTREAM_MEDIA_DIR/$name" 2>/dev/null || printf '0')"
        case "$name" in
            *.*) ext="${name##*.}" ;;
            *)   ext="unknown" ;;
        esac
        {
            printf '\0'
            printf 'name\0%s\0'      "$name"
            printf 'size\0%s\0'      "$size"
            printf 'extension\0%s\0' "$ext"
        }
    done | wc_json array
}

wc_op_relay_create_url() {
    local name="${1:-}" url="${2:-}" type="" rc
    [ -n "$name" ] || wc_fail "missing stream name" "MISSING_TARGET"
    bs_valid_name "$name" || wc_fail "invalid stream name" "INVALID_NAME"
    [ -n "$url" ] || wc_fail "missing source URL" "MISSING_URL"
    bs_valid_url "$url" || wc_fail "unsupported or malformed source URL" "INVALID_URL"
    type="$(bs_classify_source_type "$url")" || wc_fail "unsupported source URL scheme" "UNSUPPORTED_URL"
    relay_exists "$name" && wc_fail "stream already exists: $name" "ALREADY_EXISTS"
    ( relay_create "$name" "$type" "$url" ) >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 0 ] || wc_fail "stream creation failed" "CREATION_FAILED"
    printf 'operation\0%s\0name\0%s\0type\0%s\0' "relay_create_url" "$name" "$type" | wc_json object
}

wc_op_relay_create_media() {
    local name="${1:-}" media="${2:-}" rc
    [ -n "$name" ] || wc_fail "missing stream name" "MISSING_TARGET"
    bs_valid_name "$name" || wc_fail "invalid stream name" "INVALID_NAME"
    [ -n "$media" ] || wc_fail "missing media name" "MISSING_MEDIA"
    bs_valid_media_name "$media" || wc_fail "invalid media name" "INVALID_MEDIA"
    relay_exists "$name" && wc_fail "stream already exists: $name" "ALREADY_EXISTS"
    [ -f "$BLUESTREAM_MEDIA_DIR/$media" ] || wc_fail "media not found: $media" "MEDIA_NOT_FOUND"
    ( relay_create "$name" "local-file" "$BLUESTREAM_MEDIA_DIR/$media" ) >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 0 ] || wc_fail "stream creation failed" "CREATION_FAILED"
    printf 'operation\0%s\0name\0%s\0type\0local-file\0' "relay_create_media" "$name" | wc_json object
}

wc_op_media_import_staged() {
    local stagingfile="${1:-}" rc
    [ -n "$stagingfile" ] || wc_fail "missing upload id" "MISSING_STAGING"
    bs_valid_media_name "$stagingfile" || wc_fail "invalid upload id" "INVALID_STAGING"
    # The complete filesystem trust boundary (web staging -> root-only
    # quarantine -> symlink rejection -> ffprobe -> no-overwrite import) is
    # enforced by the authoritative media_import_staged engine function. The
    # bridge only maps its exit status to a controlled JSON error code and
    # never re-implements a second (weaker) trust decision.
    ( media_import_staged "$stagingfile" ) >/dev/null 2>&1
    rc=$?
    case "$rc" in
        0) ;;
        1) wc_fail "invalid upload id" "INVALID_STAGING" ;;
        2) wc_fail "staged upload not found" "STAGING_NOT_FOUND" ;;
        3) wc_fail "a file with this name already exists in managed media" "MEDIA_EXISTS" ;;
        4) wc_fail "staged upload is not a regular file" "NOT_REGULAR" ;;
        5) wc_fail "ffprobe is unavailable for media validation" "NO_FFPROBE" ;;
        6) wc_fail "uploaded file is not recognized media" "NOT_MEDIA" ;;
        *) wc_fail "media import failed" "IMPORT_FAILED" ;;
    esac
    printf 'operation\0%s\0name\0%s\0' "media_import_staged" "$stagingfile" | wc_json object
}

# ---------------------------------------------------------------------------
# GUI-1D.1: playlist creation (fixed argv, strict validation, fail closed).
# ---------------------------------------------------------------------------
wc_op_playlist_create() {
    local name="${1:-}"
    shift || true
    [ -n "$name" ] || wc_fail "missing playlist name" "MISSING_TARGET"
    # Revalidate the playlist ID with the engine's own name rule before any
    # engine function runs (rejects option-like, traversal, spaces, shell
    # metacharacters, and >48-char names).
    bs_valid_name "$name" || wc_fail "invalid playlist name" "INVALID_NAME"
    playlist_exists "$name" && wc_fail "a playlist named '$name' already exists" "ALREADY_EXISTS"
    # Minimum two media items (product rule) and the engine's shared ceiling.
    if [ "$#" -lt 2 ]; then
        wc_fail "a playlist needs at least two media files" "TOO_FEW_ITEMS"
    fi
    if [ "$#" -gt "$BLUESTREAM_PLAYLIST_MAX_ITEMS" ]; then
        wc_fail "too many media files (maximum is $BLUESTREAM_PLAYLIST_MAX_ITEMS)" "TOO_MANY_ITEMS"
    fi
    # Independently revalidate every media basename here.  Two passes: first
    # names + duplicates (so no arbitrary value or duplicate ever reaches the
    # engine or a filesystem path), then authoritative existence in managed
    # media.  The engine's playlist_create_items re-validates everything again
    # as a backstop and is only reached with fully-validated data.
    local f seen=""
    for f in "$@"; do
        bs_valid_media_name "$f" || wc_fail "invalid media name" "INVALID_MEDIA"
        case " $seen " in
            *" $f "*) wc_fail "the same media file cannot be used more than once" "DUPLICATE_ITEM" ;;
        esac
        seen="$seen $f"
    done
    for f in "$@"; do
        [ -f "$BLUESTREAM_MEDIA_DIR/$f" ] || wc_fail "media file not found: $f" "MEDIA_NOT_FOUND"
    done
    ( playlist_create_items "$name" "$@" ) >/dev/null 2>&1
    rc=$?
    case "$rc" in
        0) ;;
        1) wc_fail "invalid playlist name" "INVALID_NAME" ;;
        2) wc_fail "a playlist named '$name' already exists" "ALREADY_EXISTS" ;;
        3) wc_fail "a playlist needs at least two media files" "TOO_FEW_ITEMS" ;;
        4) wc_fail "too many media files" "TOO_MANY_ITEMS" ;;
        5) wc_fail "invalid media name" "INVALID_MEDIA" ;;
        6) wc_fail "one or more media files are no longer available" "MEDIA_NOT_FOUND" ;;
        7) wc_fail "the same media file cannot be used more than once" "DUPLICATE_ITEM" ;;
        *) wc_fail "playlist creation failed" "CREATION_FAILED" ;;
    esac
    printf 'operation\0%s\0name\0%s\0items\0%d\0' "playlist_create" "$name" "$#" | wc_json object
}

# ---------------------------------------------------------------------------
# GUI-3A: playlist cache visibility + conservative manual cleanup. Both
# operations take NO arguments (dispatch enforces argc == 1), so no path or
# filename can ever reach the privileged engine from the browser. The engine
# derives the protected set internally from live systemd state + concat files.
# ---------------------------------------------------------------------------
wc_op_playlist_cache_status() {
    if ! playlist_cache_scan status 2>/dev/null; then
        wc_fail "playlist cache status is unavailable" "CACHE_STATUS_FAILED"
    fi
    {
        printf 'total_bytes\0%d\0'        "$CACHE_TOTAL_BYTES"
        printf 'artifact_count\0%d\0'     "$CACHE_ARTIFACT_COUNT"
        printf 'protected_bytes\0%d\0'    "$CACHE_PROTECTED_BYTES"
        printf 'protected_count\0%d\0'    "$CACHE_PROTECTED_COUNT"
        printf 'reclaimable_bytes\0%d\0'  "$CACHE_RECLAIMABLE_BYTES"
        printf 'reclaimable_count\0%d\0'  "$CACHE_RECLAIMABLE_COUNT"
    } | wc_json object
}

wc_op_playlist_cache_clear_unused() {
    # Holds the shared cache flock for each authoritative scan/delete pass inside
    # playlist_cache_scan (released between bounded settle-retries), so playlist
    # preparation can never interleave with a delete and no deadlock is created.
    if ! playlist_cache_scan clear 2>/dev/null; then
        wc_fail "playlist cache could not be cleared safely" "CACHE_CLEAR_FAILED"
    fi
    {
        printf 'operation\0%s\0'         "playlist_cache_clear_unused"
        printf 'freed_bytes\0%d\0'       "$CACHE_FREED_BYTES"
        printf 'freed_count\0%d\0'       "$CACHE_FREED_COUNT"
        printf 'reclaimable_bytes\0%d\0' "$CACHE_RECLAIMABLE_BYTES"
        printf 'reclaimable_count\0%d\0' "$CACHE_RECLAIMABLE_COUNT"
        # 1 when the only blocker was a settling systemd lifecycle transition
        # that did not resolve within the bounded recheck window.
        printf 'blocked\0%d\0'           "${CACHE_BLOCKED:-0}"
    } | wc_json object
}

# ---------------------------------------------------------------------------
# Controlled lifecycle operations (GUI-1B.1): exactly one validated target.
# ---------------------------------------------------------------------------
wc_op_lifecycle() {
    local op="$1" name="${2:-}" kind="" action="" rc
    case "$op" in
        relay_start|relay_stop|relay_restart) kind="relay" ;;
        playlist_start|playlist_stop|playlist_restart) kind="playlist" ;;
    esac
    [ -n "$kind" ] || wc_fail "unsupported lifecycle operation: $op" "UNKNOWN_OPERATION"
    case "$op" in
        relay_start|playlist_start)             action="start" ;;
        relay_stop|playlist_stop)               action="stop" ;;
        relay_restart|playlist_restart)         action="restart" ;;
    esac
    [ -n "$name" ] || wc_fail "missing ${kind} name" "MISSING_TARGET"
    # Reuse the engine's own name rule.  The target can only reach an engine
    # function or a filesystem path after matching [a-z0-9_-] with an
    # alphanumeric first character (rejects option-like, traversal, spaces and
    # shell metacharacters), so no path or unit name is ever derived from
    # unvalidated browser data.
    bs_valid_name "$name" || wc_fail "invalid ${kind} name" "INVALID_NAME"
    if [ "$kind" = "relay" ]; then
        relay_exists "$name" || wc_fail "relay not found: $name" "NOT_FOUND"
    else
        playlist_exists "$name" || wc_fail "playlist not found: $name" "NOT_FOUND"
    fi
    # Run the existing engine lifecycle function in a subshell so its internal
    # bs_die()/exit cannot terminate the bridge.  Operator output is discarded
    # and only the exit status drives the JSON result.
    case "$op" in
        relay_start)      ( relay_start "$name" ) ;;
        relay_stop)       ( relay_stop "$name" ) ;;
        relay_restart)    ( relay_restart "$name" ) ;;
        playlist_start)   ( playlist_start "$name" ) ;;
        playlist_stop)    ( playlist_stop "$name" ) ;;
        playlist_restart) ( playlist_restart "$name" ) ;;
    esac >/dev/null 2>&1
    rc=$?
    if [ "$rc" -ne 0 ]; then
        wc_fail "${kind} $action failed" "OPERATION_FAILED"
    fi
    printf 'operation\0%s\0name\0%s\0' "$op" "$name" | wc_json object
}

# ---------------------------------------------------------------------------
# GUI-4 Phase 1A: destination management. destination_list NEVER emits the
# stored stream key - only a has_stream_key flag. destination_create reads
# exactly one secret value from STDIN (never argv/env); enable/disable/delete
# take exactly one validated destination ID. No outgoing RTMP process/service
# is started.
# ---------------------------------------------------------------------------
wc_op_destination_list() {
    local name display platform url enabled haskey attached
    for name in $(dest_list_names 2>/dev/null); do
        # Names come from validated destination config discovery ([a-z0-9_-]);
        # the for-loop word split is therefore safe.
        display=""; platform=""; url=""; enabled="no"; haskey="no"
        if dest_load_config "$name" 2>/dev/null; then
            display="$DEST_DISPLAY"
            platform="$DEST_PLATFORM"
            url="$(bs_redact_url "$DEST_SERVER_URL")"
            enabled="$DEST_ENABLED"
            if [ -n "$DEST_STREAM_KEY" ]; then haskey="yes"; fi
        fi
        # Phase 1B: how many streams/playlists this destination is attached to
        # (0 = safe to delete). Never emits the stream key.
        attached="$(dest_attached_targets "$name" 2>/dev/null | grep -c . || true)"
        [ -n "$attached" ] || attached="0"
        {
            printf '\0'
            printf 'name\0%s\0'            "$name"
            printf 'display_name\0%s\0'    "$display"
            printf 'platform\0%s\0'        "$platform"
            printf 'server_url\0%s\0'      "$url"
            printf 'enabled\0%s\0'         "$enabled"
            printf 'has_stream_key\0%s\0'  "$haskey"
            printf 'attached_count\0%s\0'  "$attached"
        }
    done | wc_json array
}

# ---------------------------------------------------------------------------
# GUI-4 Phase 1B: destination attachments. Read the attached IDs for a target
# and replace them with a validated, bounded, de-duplicated ID list. IDs ONLY
# ever cross this boundary - never a stream key/secret/publish URL. No systemd
# unit is touched, so a running stream/playlist is never restarted, and no
# outgoing RTMP push is started (that is Phase 1C).
# ---------------------------------------------------------------------------
wc_op_target_destinations_get() {
    local kind="$1" name="${2:-}" id
    bs_valid_name "$name" || wc_fail "invalid ${kind} name" "INVALID_NAME"
    if [ "$kind" = "relay" ]; then
        relay_exists "$name" || wc_fail "stream not found: $name" "NOT_FOUND"
        {
            while IFS= read -r id; do
                [ -n "$id" ] || continue
                printf '\0'
                printf 'name\0%s\0' "$id"
            done < <(relay_get_destinations "$name" 2>/dev/null || true)
        } | wc_json array
    else
        playlist_exists "$name" || wc_fail "playlist not found: $name" "NOT_FOUND"
        {
            while IFS= read -r id; do
                [ -n "$id" ] || continue
                printf '\0'
                printf 'name\0%s\0' "$id"
            done < <(playlist_get_destinations "$name" 2>/dev/null || true)
        } | wc_json array
    fi
}

wc_op_target_destinations_set() {
    local kind="$1" name="${2:-}" csv="${3-}" rc
    bs_valid_name "$name" || wc_fail "invalid ${kind} name" "INVALID_NAME"
    if [ "$kind" = "relay" ]; then
        relay_exists "$name" || wc_fail "stream not found: $name" "NOT_FOUND"
    else
        playlist_exists "$name" || wc_fail "playlist not found: $name" "NOT_FOUND"
    fi
    # Independently normalize/validate the ID list here (safe grammar, existing
    # destinations, no duplicates, bounded count) before the engine setter runs.
    bs_dest_attach_normalize "$csv"
    rc=$?
    case "$rc" in
        0) ;;
        1) wc_fail "invalid destination id" "INVALID_DESTINATION" ;;
        2) wc_fail "the same destination cannot be attached twice" "DUPLICATE_DESTINATION" ;;
        3) wc_fail "one or more destinations do not exist" "DESTINATION_NOT_FOUND" ;;
        4) wc_fail "too many destinations (maximum is $BLUESTREAM_MAX_TARGET_DESTINATIONS)" "TOO_MANY_DESTINATIONS" ;;
        *) wc_fail "invalid destination list" "INVALID_DESTINATION" ;;
    esac
    if [ "$kind" = "relay" ]; then
        ( relay_set_destinations "$name" "$DEST_ATTACH_CSV" ) >/dev/null 2>&1
    else
        ( playlist_set_destinations "$name" "$DEST_ATTACH_CSV" ) >/dev/null 2>&1
    fi
    rc=$?
    case "$rc" in
        0) ;;
        1) wc_fail "invalid ${kind} name" "INVALID_NAME" ;;
        2) wc_fail "${kind} not found: $name" "NOT_FOUND" ;;
        3) wc_fail "invalid destination list" "INVALID_DESTINATION" ;;
        *) wc_fail "could not update attachments" "OPERATION_FAILED" ;;
    esac
    printf 'operation\0%s\0name\0%s\0count\0%s\0' \
        "${kind}_destinations_set" "$name" "$(bs_dest_attach_count "$DEST_ATTACH_CSV")" | wc_json object
}

wc_op_destination_create() {
    local name="${1:-}" display="${2:-}" platform="${3:-}" url="${4:-}"
    local enabled="${5:-}" key="" rc
    bs_valid_name "$name" || wc_fail "invalid destination name" "INVALID_NAME"
    bs_valid_dest_display "$display" || wc_fail "invalid destination display name" "INVALID_DISPLAY"
    bs_valid_platform "$platform" || wc_fail "unknown platform" "UNKNOWN_PLATFORM"
    [ -n "$url" ] || wc_fail "missing server URL" "MISSING_URL"
    bs_valid_dest_url "$url" || wc_fail "unsupported or malformed server URL" "INVALID_URL"
    case "$enabled" in yes|no) ;; *) wc_fail "invalid enabled value" "INVALID_ENABLED" ;; esac
    # The stream key is NEVER an argv element or environment variable: read
    # exactly one secret value from stdin. IFS= preserves leading/trailing
    # spaces and other permitted printable characters; `read` strips only the
    # terminating newline, so a key can never contain a newline. Any further
    # stdin content after the first line is intentionally ignored.
    key=""
    IFS= read -r key || true
    [ -n "$key" ] || wc_fail "missing stream key" "MISSING_STREAM_KEY"
    bs_valid_stream_key "$key" || wc_fail "invalid stream key" "INVALID_STREAM_KEY"
    dest_exists "$name" && wc_fail "a destination named '$name' already exists" "ALREADY_EXISTS"
    ( dest_create "$name" "$display" "$platform" "$url" "$key" "$enabled" ) >/dev/null 2>&1
    rc=$?
    case "$rc" in
        0) ;;
        1) wc_fail "invalid destination name" "INVALID_NAME" ;;
        2) wc_fail "invalid destination display name" "INVALID_DISPLAY" ;;
        3) wc_fail "unknown platform" "UNKNOWN_PLATFORM" ;;
        4) wc_fail "unsupported or malformed server URL" "INVALID_URL" ;;
        5) wc_fail "invalid stream key" "INVALID_STREAM_KEY" ;;
        6) wc_fail "invalid enabled value" "INVALID_ENABLED" ;;
        7) wc_fail "a destination named '$name' already exists" "ALREADY_EXISTS" ;;
        *) wc_fail "destination creation failed" "CREATION_FAILED" ;;
    esac
    # Never echo the stream key back to stdout.
    printf 'operation\0%s\0name\0%s\0display_name\0%s\0platform\0%s\0' \
        "destination_create" "$name" "$display" "$platform" | wc_json object
}

wc_op_destination_state() {
    local op="$1" name="${2:-}" enabled="" rc
    case "$op" in
        destination_enable)  enabled="yes" ;;
        destination_disable) enabled="no" ;;
        *) wc_fail "unsupported destination state operation: $op" "UNKNOWN_OPERATION" ;;
    esac
    bs_valid_name "$name" || wc_fail "invalid destination name" "INVALID_NAME"
    dest_exists "$name" || wc_fail "destination not found: $name" "NOT_FOUND"
    ( dest_set_enabled "$name" "$enabled" ) >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 0 ] || wc_fail "destination $enabled operation failed" "OPERATION_FAILED"
    printf 'operation\0%s\0name\0%s\0' "$op" "$name" | wc_json object
}

wc_op_destination_delete() {
    local name="${1:-}" rc
    bs_valid_name "$name" || wc_fail "invalid destination name" "INVALID_NAME"
    dest_exists "$name" || wc_fail "destination not found: $name" "NOT_FOUND"
    ( dest_delete "$name" ) >/dev/null 2>&1
    rc=$?
    case "$rc" in
        0) ;;
        2) wc_fail "destination not found: $name" "NOT_FOUND" ;;
        3) wc_fail "Destination is attached to a stream or playlist. Detach it before deleting." "DESTINATION_ATTACHED" ;;
        *) wc_fail "destination deletion failed" "OPERATION_FAILED" ;;
    esac
    printf 'operation\0%s\0name\0%s\0' "destination_delete" "$name" | wc_json object
}

# ---------------------------------------------------------------------------
# GUI-5A: safe delete for a stream, a playlist, or a managed-media file.
# Each operation is fixed, takes EXACTLY one validated name, deletes only that
# target's own artifacts, and fails closed with a controlled code.
# ---------------------------------------------------------------------------
wc_op_relay_delete() {
    local name="${1:-}" rc
    bs_valid_name "$name" || wc_fail "invalid stream name" "INVALID_NAME"
    relay_exists "$name" || wc_fail "stream not found: $name" "NOT_FOUND"
    ( relay_delete "$name" ) >/dev/null 2>&1
    rc=$?
    case "$rc" in
        0) ;;
        2) wc_fail "stream not found: $name" "NOT_FOUND" ;;
        3) wc_fail "This stream is not stopped. Stop it, then delete it." "NOT_STOPPED" ;;
        *) wc_fail "stream deletion failed" "OPERATION_FAILED" ;;
    esac
    printf 'operation\0%s\0name\0%s\0' "relay_delete" "$name" | wc_json object
}

wc_op_playlist_delete() {
    local name="${1:-}" rc
    bs_valid_name "$name" || wc_fail "invalid playlist name" "INVALID_NAME"
    playlist_exists "$name" || wc_fail "playlist not found: $name" "NOT_FOUND"
    ( playlist_delete "$name" ) >/dev/null 2>&1
    rc=$?
    case "$rc" in
        0) ;;
        2) wc_fail "playlist not found: $name" "NOT_FOUND" ;;
        3) wc_fail "This playlist is not stopped. Stop it, then delete it." "NOT_STOPPED" ;;
        *) wc_fail "playlist deletion failed" "OPERATION_FAILED" ;;
    esac
    printf 'operation\0%s\0name\0%s\0' "playlist_delete" "$name" | wc_json object
}

wc_op_media_delete() {
    local name="${1:-}" rc
    bs_valid_media_name "$name" || wc_fail "invalid media file name" "INVALID_MEDIA"
    ( media_delete "$name" ) >/dev/null 2>&1
    rc=$?
    case "$rc" in
        0) ;;
        1) wc_fail "invalid media file name" "INVALID_MEDIA" ;;
        2) wc_fail "media file not found: $name" "NOT_FOUND" ;;
        3) wc_fail "media entry is not a regular file" "NOT_REGULAR" ;;
        4) wc_fail "This media file is used by a stream or playlist. Remove those first." "MEDIA_REFERENCED" ;;
        *) wc_fail "media deletion failed" "OPERATION_FAILED" ;;
    esac
    printf 'operation\0%s\0name\0%s\0' "media_delete" "$name" | wc_json object
}

# ---------------------------------------------------------------------------
# GUI-6A: edit the source URL of a stopped, URL-backed stream. EXACTLY name +
# URL. The URL is treated strictly as data (validated, never interpolated
# into shell code). Media-backed streams and running streams are refused.
# ---------------------------------------------------------------------------
wc_op_relay_set_source() {
    local name="${1:-}" url="${2:-}" rc
    bs_valid_name "$name" || wc_fail "invalid stream name" "INVALID_NAME"
    relay_exists "$name" || wc_fail "stream not found: $name" "NOT_FOUND"
    [ -n "$url" ] || wc_fail "missing source URL" "MISSING_URL"
    bs_valid_url "$url" || wc_fail "unsupported or malformed source URL" "INVALID_URL"
    bs_classify_source_type "$url" >/dev/null || wc_fail "unsupported source URL scheme" "UNSUPPORTED_URL"
    ( relay_set_source "$name" "$url" ) >/dev/null 2>&1
    rc=$?
    case "$rc" in
        0) ;;
        2) wc_fail "stream not found: $name" "NOT_FOUND" ;;
        3) wc_fail "This stream is not stopped. Stop it, then edit the source." "NOT_STOPPED" ;;
        4) wc_fail "This stream uses managed media, not a URL. Its source cannot be edited here." "MEDIA_BACKED" ;;
        5) wc_fail "unsupported or malformed source URL" "INVALID_URL" ;;
        *) wc_fail "could not update the stream source" "OPERATION_FAILED" ;;
    esac
    printf 'operation\0%s\0name\0%s\0' "relay_set_source" "$name" | wc_json object
}

# ---------------------------------------------------------------------------
# GUI-8A: one-time playlist start schedule. get is read-only; set takes a
# validated future UTC epoch + a display-only ISO string; clear is idempotent.
# A root-generated systemd timer targets a FIXED oneshot service - never a
# browser-supplied command.
# ---------------------------------------------------------------------------
wc_op_playlist_schedule_get() {
    local name="${1:-}" scheduled="no" at="" iso="" state=""
    bs_valid_name "$name" || wc_fail "invalid playlist name" "INVALID_NAME"
    playlist_exists "$name" || wc_fail "playlist not found: $name" "NOT_FOUND"
    if schedule_load "$name" 2>/dev/null; then
        scheduled="yes"; at="$SCHEDULE_START_AT"; iso="$SCHEDULE_START_AT_ISO"
        # "pending" (still in the future) or "missed" (the instant has passed).
        state="$(schedule_state "$SCHEDULE_START_AT")"
    fi
    {
        printf 'scheduled\0%s\0'        "$scheduled"
        printf 'start_at\0%s\0'         "$at"
        printf 'start_at_iso\0%s\0'     "$iso"
        printf 'state\0%s\0'            "$state"
    } | wc_json object
}

wc_op_playlist_schedule_set() {
    local name="${1:-}" epoch="${2:-}" iso="${3:-}" rc
    bs_valid_name "$name" || wc_fail "invalid playlist name" "INVALID_NAME"
    playlist_exists "$name" || wc_fail "playlist not found: $name" "NOT_FOUND"
    bs_valid_epoch "$epoch" || wc_fail "invalid schedule timestamp" "INVALID_SCHEDULE"
    bs_valid_schedule_iso "$iso" || wc_fail "invalid schedule timestamp" "INVALID_SCHEDULE"
    ( schedule_set "$name" "$epoch" "$iso" ) >/dev/null 2>&1
    rc=$?
    case "$rc" in
        0) ;;
        1) wc_fail "invalid playlist name" "INVALID_NAME" ;;
        2) wc_fail "playlist not found: $name" "NOT_FOUND" ;;
        3) wc_fail "invalid schedule timestamp" "INVALID_SCHEDULE" ;;
        4) wc_fail "The scheduled time is in the past." "SCHEDULE_IN_PAST" ;;
        *) wc_fail "could not schedule the playlist start" "OPERATION_FAILED" ;;
    esac
    printf 'operation\0%s\0name\0%s\0start_at\0%s\0' "playlist_schedule_set" "$name" "$epoch" | wc_json object
}

wc_op_playlist_schedule_clear() {
    local name="${1:-}" rc
    bs_valid_name "$name" || wc_fail "invalid playlist name" "INVALID_NAME"
    playlist_exists "$name" || wc_fail "playlist not found: $name" "NOT_FOUND"
    ( schedule_clear "$name" ) >/dev/null 2>&1
    rc=$?
    [ "$rc" -eq 0 ] || wc_fail "could not cancel the schedule" "OPERATION_FAILED"
    printf 'operation\0%s\0name\0%s\0' "playlist_schedule_clear" "$name" | wc_json object
}

# ---------------------------------------------------------------------------
# Dispatch: hard-coded allowlist, fail closed.  No dynamic execution.
# ---------------------------------------------------------------------------
wc_dispatch() {
    local operation="${1:-}" name="${2:-}" value2="${3:-}"
    # argcount = total number of original shell argv entries (operation included).
    local argcount="$#"
    case "$operation" in
        version)       wc_op_version ;;
        snapshot)      wc_op_snapshot ;;
        relay_list)    wc_op_relay_list ;;
        playlist_list) wc_op_playlist_list ;;
        media_list)
            [ "$argcount" -eq 1 ] || wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            wc_op_media_list
            ;;
        playlist_cache_status|playlist_cache_clear_unused)
            # GUI-3A: fixed operations with NO arguments (shell argv count == 1).
            # No path or filename can ever reach the privileged engine.
            if [ "$argcount" -ne 1 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            if [ "$operation" = "playlist_cache_status" ]; then
                wc_op_playlist_cache_status
            else
                wc_op_playlist_cache_clear_unused
            fi
            ;;
        relay_start|relay_stop|relay_restart|playlist_start|playlist_stop|playlist_restart)
            # Lifecycle operations accept EXACTLY operation + one target
            # (shell argv count == 2).  An explicitly empty third argument
            # still counts as an extra argument, and a fourth+ argument can
            # never hide behind an empty third.
            if [ "$argcount" -lt 2 ]; then
                wc_fail "missing target name" "MISSING_TARGET"
            fi
            if [ "$argcount" -gt 2 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            wc_op_lifecycle "$operation" "$name"
            ;;
        media_import_staged)
            # EXACTLY operation + one staging id (shell argv count == 2).
            if [ "$argcount" -lt 2 ]; then
                wc_fail "missing upload id" "MISSING_TARGET"
            fi
            if [ "$argcount" -gt 2 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            wc_op_media_import_staged "$name"
            ;;
        playlist_create)
            # Fixed operation + playlist ID + 2..MAX_ITEMS media basenames
            # (shell argv count ranges from 3 to 1+BLUESTREAM_PLAYLIST_MAX_ITEMS).
            # The whole allowlist is fixed here; only the validated data values
            # are passed on, each as its own argv element - never a shell string.
            if [ "$argcount" -lt 3 ]; then
                wc_fail "missing argument" "MISSING_ARGUMENT"
            fi
            if [ "$argcount" -gt $((1 + BLUESTREAM_PLAYLIST_MAX_ITEMS)) ]; then
                wc_fail "too many arguments" "TOO_MANY_ARGUMENTS"
            fi
            shift 2  # drop operation + name; remaining "$@" are the media items
            wc_op_playlist_create "$name" "$@"
            ;;
        destination_list)
            # Read-only destination list; NO stream key is ever emitted.
            if [ "$argcount" -ne 1 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            wc_op_destination_list
            ;;
        destination_create)
            # EXACTLY operation + 5 fixed NON-SECRET values (id display
            # platform url enabled); shell argv count == 6. The stream key is
            # read from STDIN, never from argv.
            if [ "$argcount" -lt 6 ]; then
                wc_fail "missing argument" "MISSING_ARGUMENT"
            fi
            if [ "$argcount" -gt 6 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            shift 1  # drop operation; remaining "$@" are the 5 fixed values
            wc_op_destination_create "$@"
            ;;
        destination_enable|destination_disable|destination_delete)
            # EXACTLY operation + one validated destination ID (argv == 2).
            if [ "$argcount" -lt 2 ]; then
                wc_fail "missing destination name" "MISSING_TARGET"
            fi
            if [ "$argcount" -gt 2 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            case "$operation" in
                destination_delete) wc_op_destination_delete "$name" ;;
                *) wc_op_destination_state "$operation" "$name" ;;
            esac
            ;;
        relay_create_url|relay_create_media)
            # EXACTLY operation + two arguments (shell argv count == 3).
            if [ "$argcount" -lt 3 ]; then
                wc_fail "missing argument" "MISSING_ARGUMENT"
            fi
            if [ "$argcount" -gt 3 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            case "$operation" in
                relay_create_url)  wc_op_relay_create_url  "$name" "$value2" ;;
                relay_create_media) wc_op_relay_create_media "$name" "$value2" ;;
            esac
            ;;
        relay_destinations_get|playlist_destinations_get)
            # Phase 1B: EXACTLY operation + one validated target name (argv == 2).
            if [ "$argcount" -lt 2 ]; then
                wc_fail "missing target name" "MISSING_TARGET"
            fi
            if [ "$argcount" -gt 2 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            case "$operation" in
                relay_destinations_get)    wc_op_target_destinations_get relay "$name" ;;
                playlist_destinations_get) wc_op_target_destinations_get playlist "$name" ;;
            esac
            ;;
        relay_destinations_set|playlist_destinations_set)
            # Phase 1B: EXACTLY operation + target name + ONE ID-list value
            # (argv == 3). The list value may be the empty string (detach all)
            # but must still be present as its own argv element.
            if [ "$argcount" -lt 3 ]; then
                wc_fail "missing argument" "MISSING_ARGUMENT"
            fi
            if [ "$argcount" -gt 3 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            case "$operation" in
                relay_destinations_set)    wc_op_target_destinations_set relay "$name" "$value2" ;;
                playlist_destinations_set) wc_op_target_destinations_set playlist "$name" "$value2" ;;
            esac
            ;;
        relay_delete|playlist_delete|media_delete)
            # GUI-5A: EXACTLY operation + one validated name (argv == 2). The
            # operation is fixed here; the engine function deletes only that
            # one target's own artifacts and fails closed otherwise.
            if [ "$argcount" -lt 2 ]; then
                wc_fail "missing target name" "MISSING_TARGET"
            fi
            if [ "$argcount" -gt 2 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            case "$operation" in
                relay_delete)    wc_op_relay_delete "$name" ;;
                playlist_delete) wc_op_playlist_delete "$name" ;;
                media_delete)    wc_op_media_delete "$name" ;;
            esac
            ;;
        relay_set_source)
            # GUI-6A: EXACTLY operation + name + URL (argv == 3).
            if [ "$argcount" -lt 3 ]; then
                wc_fail "missing argument" "MISSING_ARGUMENT"
            fi
            if [ "$argcount" -gt 3 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            wc_op_relay_set_source "$name" "$value2"
            ;;
        playlist_schedule_get|playlist_schedule_clear)
            # GUI-8A: EXACTLY operation + one validated playlist name (argv == 2).
            if [ "$argcount" -lt 2 ]; then
                wc_fail "missing playlist name" "MISSING_TARGET"
            fi
            if [ "$argcount" -gt 2 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            case "$operation" in
                playlist_schedule_get)   wc_op_playlist_schedule_get "$name" ;;
                playlist_schedule_clear) wc_op_playlist_schedule_clear "$name" ;;
            esac
            ;;
        playlist_schedule_set)
            # GUI-8A: EXACTLY operation + name + epoch + iso (argv == 4).
            if [ "$argcount" -lt 4 ]; then
                wc_fail "missing argument" "MISSING_ARGUMENT"
            fi
            if [ "$argcount" -gt 4 ]; then
                wc_fail "unexpected extra argument" "TOO_MANY_ARGUMENTS"
            fi
            wc_op_playlist_schedule_set "$name" "$value2" "${4:-}"
            ;;
        '')
            wc_fail "no operation specified (usage: web-ctl version|snapshot|relay_list|playlist_list|media_list|relay_start|relay_stop|relay_restart|playlist_start|playlist_stop|playlist_restart|relay_create_url|relay_create_media|media_import_staged|playlist_create|playlist_cache_status|playlist_cache_clear_unused|destination_list|destination_create|destination_enable|destination_disable|destination_delete|relay_destinations_get|relay_destinations_set|playlist_destinations_get|playlist_destinations_set|relay_delete|playlist_delete|media_delete|relay_set_source|playlist_schedule_get|playlist_schedule_set|playlist_schedule_clear)" "MISSING_OPERATION"
            ;;
        *)
            wc_fail "unknown operation: $operation" "UNKNOWN_OPERATION"
            ;;
    esac
}

wc_dispatch "$@"
