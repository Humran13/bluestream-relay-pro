# Normalise line endings so scripts ship with LF (required by bash on Ubuntu).
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
bluestream-manager text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
VERSION text eol=lf
